# Node modules (MUST ignore)
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Environment variables (VERY IMPORTANT)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Temporary files
tmp/
temp/

# Build output (if any)
dist/
build/

# Coverage reports
coverage/

# Optional: lock file (choose based on your preference)
# package-lock.json
# yarn.lock

# PM2 dump file (optional)
dump.pm2

# SSL / sensitive files
*.pem
*.key